# A long, random value used to sign session cookies and encrypt Cockpit passwords.
# If it changes, stored Cockpit passwords can no longer be decrypted.
SECRET_KEY=a_very_secure_and_random_string
PORT=7435
# The address the gateway is reached at from outside (for OAuth redirects)
PUBLIC_URL=https://mcp.example.com
# The Cockpit that verifies logins. Default: the host machine the gateway runs on.
COCKPIT_AUTH_URL=https://host.docker.internal:9090
# Whether to verify the Cockpit certificate (leave false if it is self-signed)
COCKPIT_AUTH_VERIFY_TLS=false
# If empty, every user who can log in to Cockpit; otherwise only these users (comma separated)
ALLOWED_USERS=bmericc
# Access token required in addition to the Cockpit login (second factor). Must be long and random.
# If added to the MCP address (https://.../sse?token=...), the login page does not ask for it again.
# If left empty, the Cockpit username/password alone is enough. If changed, everyone has to log in again.
MCP_API_KEY=xxx-long-random-token
SSH_LOGINS=root:/root/.ssh,bmericc:/home/bmericc/.ssh
# Optional: default proxy for connections to the servers (Cockpit and SSH).
# The servers see the proxy's IP address instead of the gateway's. Can be changed per server in the panel.
# Example: socks5://10.0.0.1:1080, socks5h://user:password@proxy:1080, http://proxy:3128
OUTBOUND_PROXY=
# Optional: maximum size of the audit log file (data/audit.log), in MB. When full it is rotated to .1.
AUDIT_LOG_MAX_MB=10
