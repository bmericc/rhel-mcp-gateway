# Oturum çerezlerini imzalamak ve Cockpit şifrelerini şifrelemek için rastgele, uzun bir değer.
# Değiştirilirse kayıtlı Cockpit şifreleri çözülemez.
SECRET_KEY=cok_guvenli_ve_rastgele_bir_string
PORT=7435
# Gateway'in dışarıdan erişilen adresi (OAuth yönlendirmeleri için)
PUBLIC_URL=https://mcp.ornek.com
# Giriş doğrulaması yapılacak Cockpit. Varsayılan: gateway'in çalıştığı host makine.
COCKPIT_AUTH_URL=https://host.docker.internal:9090
# Cockpit sertifikası doğrulansın mı (kendinden imzalıysa false bırakın)
COCKPIT_AUTH_VERIFY_TLS=false
# Boşsa Cockpit'e giriş yapabilen her kullanıcı; doluysa sadece bu kullanıcılar (virgülle)
ALLOWED_USERS=bmericc
# Cockpit girişine ek olarak istenen erişim token'ı (ikinci faktör). Uzun ve rastgele olmalı.
# MCP adresine eklenirse (https://.../sse?token=...) giriş sayfasında ayrıca sorulmaz.
# Boş bırakılırsa sadece Cockpit kullanıcı adı/şifresi yeter. Değiştirilirse herkes yeniden giriş yapar.
MCP_API_KEY=xxx-uzun-rastgele-token
SSH_LOGINS=root:/root/.ssh,bmericc:/home/bmericc/.ssh
